# 現在のWebアプリ（api/ + web/）用。プロジェクトとキーを設定する。
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# サーバー専用。ブラウザ用キーは web/config.js に設定する。
MAPS_API_KEY=
PLACES_CHECK=on
ROUTE_DAILY_LIMIT=30
ROUTE_PER_IP_HOUR=6

# 手元で用意したOSM XML。scripts/build_osm_json.py でJSONに変換する。
OSM_FILE=data/area.osm
OSM_RIVER_FILE=data/area.osm
